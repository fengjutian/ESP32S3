# This board is an ESP32-S3 module with 16 MB SPI flash.
# Keeping this here (instead of only in sdkconfig, which is gitignored)
# makes the setting survive "idf.py set-target" and fresh checkouts.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 自定义分区表：app 分区放大到 4MB（默认 1MB 已经快装不下 WiFi + 中文字库）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 板上叠封 8MB Octal PSRAM：录音缓冲（16kHz × 16bit）和 TTS 音频都放这里，
# 否则内部 512KB SRAM 装不下 8 秒以上的录音。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# 表盘主循环卡死时让看门狗直接重启，而不是把最后一帧冻在屏幕上
CONFIG_ESP_TASK_WDT_PANIC=y
